# ============================================
# 管理端后台（HTTPS 外壳：检测到证书时使用）
# 本文件由容器启动脚本 40-https.sh 复制为 /etc/nginx/conf.d/admin.conf
# 访问地址：https://zhzdai.xyz:8081（证书与官网共用）
# ============================================
server {
    listen 8081 ssl;
    http2 on;
    server_name zhixuezhida.top www.zhixuezhida.top _;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    include /etc/nginx/admin-server.inc;
}
