  "cards": [
    {
      "dot": "cyan",
      "title": "管理端运行时",
      "items": [
        "React 18 + TS + Vite 5 单页应用,由 Nginx :8081 托管 dist/",
        "路由守卫按角色分流:管理员 9 项菜单、教师 6 项菜单",
        "全应用只有一个 Zustand 认证 store,登录态持久化到 localStorage"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界与鉴权",
      "items": [
        "Axios baseURL 固定为 /api,请求拦截器注入 Bearer JWT",
        "401 清除 token 并跳转 /login;403 保留登录态",
        "管理端不用 WebSocket,教师通知靠 30 秒轮询 /chat/teacher/unread"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据与 AI 出口",
      "items": [
        "MySQL 8.0 承载持久化;Redis 承载缓存、分布式幂等与限流(该改动尚未提交)",
        "AI 由后端统一调用:DeepSeek 生成 + 本地 BGE-M3 向量化",
        "管理端 src 内无任何第三方 SaaS 直连,全部经后端"
      ]
    }
  ]
