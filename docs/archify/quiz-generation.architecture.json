  "cards": [
    {
      "dot": "cyan",
      "title": "并行拆分题型",
      "items": [
        "不再一次让 AI 输出 15 道题",
        "单选7、判断3、解析3、填空2 四路并行",
        "总耗时约等于最慢题型，而不是四个题型相加"
      ]
    },
    {
      "dot": "rose",
      "title": "单飞锁",
      "items": [
        "ConcurrentHashMap inFlight 按 cacheKey 共享 Future",
        "同一份题只有一个请求真正调 AI",
        "其他请求等待同一个结果，避免重复生成"
      ]
    },
    {
      "dot": "emerald",
      "title": "Redis 共享缓存 + 题库",
      "items": [
        "Redis key: znxsgl:qbank:{cacheKey}，TTL 24 小时",
        "MySQL question_bank 持久化，服务重启不丢",
        "Redis 不可用时自动降级本地缓存"
      ]
    },
    {
      "dot": "amber",
      "title": "预生成题库",
      "items": [
        "章节导入或 AI 生成章节成功后自动触发",
        "后台预生成难度 1~3，学生点击时直接命中",
        "支持 POST /api/quiz/bank/prewarm 手动触发",
        "定时任务默认关闭，可配置凌晨执行"
      ]
    },
    {
      "dot": "violet",
      "title": "内容变化自动失效",
      "items": [
        "cacheKey 包含章节和课时的内容版本指纹",
        "章节内容更新后自动生成新 key",
        "避免继续返回旧题目"
      ]
    }
  ]
}