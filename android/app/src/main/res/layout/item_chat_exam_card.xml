<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <!-- 对方头像 -->
    <TextView
        android:id="@+id/tv_avatar_left"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:background="@drawable/bg_avatar_other" />

    <!-- 消息内容区 -->
    <LinearLayout
        android:id="@+id/ll_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="4dp">

        <TextView
            android:id="@+id/tv_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/ink_subtle"
            android:layout_marginBottom="2dp" />

        <!-- 考试/作业卡片（cookie-card：白卡 + 10dp 圆角 + 极柔和阴影） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_1"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 标题行：类型图标 + 标题 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_exam_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="试"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_exam_icon" />

                    <TextView
                        android:id="@+id/tv_exam_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="考试标题"
                        android:textSize="15sp"
                        android:fontFamily="@font/harmonyos_sans_sc_medium"
                        android:textColor="@color/ink"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- 描述（description：margin-top 1rem，灰字） -->
                <TextView
                    android:id="@+id/tv_exam_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="点击开始作答"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/ink_muted" />

                <!-- 行动区（actions：space-between） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tv_exam_source"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="老师发布"
                        android:textSize="12sp"
                        android:textColor="@color/ink_muted" />

                    <TextView
                        android:id="@+id/tv_exam_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="去考试"
                        android:textSize="12sp"
                        android:fontFamily="@font/harmonyos_sans_sc_medium"
                        android:textColor="@color/on_primary"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 自己头像 -->
    <TextView
        android:id="@+id/tv_avatar_right"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="我"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_avatar_me" />
</LinearLayout>
