<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_1">

    <com.znxsgl.student.widget.FunctionPlotView
        android:id="@+id/figure_plot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="28dp" />

    <TextView
        android:id="@+id/btn_figure_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="×"
        android:textSize="28sp"
        android:textColor="@color/ink_muted"
        android:background="@drawable/bg_circle_light"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@color/surface_1"
        android:text="点按任意处关闭"
        android:textSize="12sp"
        android:textColor="@color/ink_subtle" />
</FrameLayout>
