<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_1">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:background="@color/surface_1">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="‹"
            android:textSize="28sp"
            android:textColor="@color/primary"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="课程名"
            android:textSize="17sp"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <View android:layout_width="40dp" android:layout_height="1dp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/hairline" />

    <!-- 聊天消息区 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp" />

    <!-- 底部输入栏（加大2倍） -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@color/surface_3">

        <!-- 附件/更多：白色圆形按钮 -->
        <TextView
            android:id="@+id/btn_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="＋"
            android:textSize="22sp"
            android:textColor="@color/primary"
            android:gravity="center"
            android:background="@drawable/bg_circle_light"
            android:clickable="true"
            android:focusable="true" />

        <!-- 输入框：白底胶囊 -->
        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:maxLines="3"
            android:layout_marginHorizontal="10dp"
            android:hint="输入消息"
            android:textSize="15sp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_tertiary"
            android:background="@drawable/bg_input_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="11dp"
            android:inputType="text"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- 发送：8px 圆角主按钮，空内容自动置灰 -->
        <TextView
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="68dp"
            android:text="发送"
            android:textSize="15sp"
            android:fontFamily="@font/harmonyos_sans_sc_medium"
            android:textColor="@color/on_primary"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
