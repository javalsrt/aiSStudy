<?xml version="1.0" encoding="utf-8"?>
<!--
  「测试」页：页面样式样板（后续复刻基线）。

  在本页落地的设计要点：
  1. 层级：标题 26sp → 区块标题 13sp → 卡片主标题 15sp → 副标题 12sp，字号+颜色双重区分
  2. 形状：统一 14dp 圆角卡片，全站风格偏"友好"
  3. 阴影：不使用强投影，改用 canvas 灰底 + 纯白卡片的明度差做层级，避免杂质阴影
  4. 触控：列表行与按钮高度均 ≥48dp，落在单手拇指舒适区
  5. 排版：分隔线从文字起点开始（缩进 66dp），而不是通栏；正文加行距，段落避免孤字成行
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!-- 顶部弥散渐变：铺在内容之下做品牌氛围，底部自动渐隐到 canvas 色 -->
    <com.znxsgl.student.widget.AuroraHeaderView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no" />

<ScrollView
    android:id="@+id/test_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingBottom="104dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding">

        <!-- ===================== 页头 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="测试"
                android:textColor="@color/ink"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="页面样式样板 · 确认后复刻到其他页面"
                android:textColor="@color/ink_subtle"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===================== 示例：卡片列表 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_sm"
            android:fontFamily="sans-serif-medium"
            android:text="本周课程"
            android:textColor="@color/ink_subtle"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical">

            <!-- 行 1：图标容器 40dp，图标 20dp，方形留白让图标视觉不过大 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="课程类型"
                        android:src="@drawable/ic_schedule"
                        android:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="计算机网络基础"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="周一 第1-2节 · 张老师 · A302"
                        android:textColor="@color/ink_subtle"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="进入详情"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_tertiary" />
            </LinearLayout>

            <!-- 分隔线：从文字起点开始，不通栏 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="66dp"
                android:background="@color/hairline" />

            <!-- 行 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="资料类型"
                        android:src="@drawable/ic_doc"
                        android:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="课程资料与笔记"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="共 24 份 · 最近更新 3 天前"
                        android:textColor="@color/ink_subtle"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="进入详情"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_tertiary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="66dp"
                android:background="@color/hairline" />

            <!-- 行 3（最后一行不加分隔线收尾） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="成绩类型"
                        android:src="@drawable/ic_trophy"
                        android:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="阶段测验成绩"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="平均 86 分 · 高于班级均值"
                        android:textColor="@color/ink_subtle"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="进入详情"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== 示例：按钮与状态 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_sm"
            android:fontFamily="sans-serif-medium"
            android:text="操作"
            android:textColor="@color/ink_subtle"
            android:textSize="13sp" />

        <!-- 主按钮：48dp 高，保证触控舒适；按下变深色、禁用变浅色（状态由 bg_btn_primary 选择器控制） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="主要操作"
            android:textColor="@color/on_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_btn_primary"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="不可用状态（禁用变灰）"
            android:textColor="@color/on_primary"
            android:textSize="15sp" />

        <!-- ===================== 示例：正文排版 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_sm"
            android:fontFamily="sans-serif-medium"
            android:text="说明"
            android:textColor="@color/ink_subtle"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="这一页是复刻基线。字号层级、圆角半径、间距节奏与按钮状态都按全站规范落地，其他页面直接照此调整即可。"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="6dp"
                android:text="正文统一 14sp、行距 6dp。段落收尾尽量不留孤字成行，短句也保持完整语义，避免阅读节奏被打断。"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

</FrameLayout>
