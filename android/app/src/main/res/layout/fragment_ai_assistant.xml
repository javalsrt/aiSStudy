<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 助手页。
  顶部改为「测试」页同一套弥散渐变（AuroraHeaderView）：渐变铺在内容之下，
  标题栏改透明叠在渐变上，状态栏与标题区之间不再出现白色硬边。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!-- 顶部弥散渐变：品牌氛围，底部自动渐隐到 canvas 色 -->
    <com.znxsgl.student.widget.AuroraHeaderView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <!-- 顶部栏：透明底，让渐变透上来；不再有 elevation 投影 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:background="@android:color/transparent">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="智学助手"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="校园版"
                android:textColor="@color/ink_subtle"
                android:textSize="11sp" />

            <!-- 新建会话：清空当前对话，回到欢迎页 -->
            <ImageView
                android:id="@+id/btnNewChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_add"
                android:tint="@color/ink"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="新建会话"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 欢迎卡片（首次进入展示，提问后隐藏） -->
                <LinearLayout
                    android:id="@+id/welcomeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_ai_welcome"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ai"
                        android:tint="@color/primary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="你好，我是智学助手"
                        android:textColor="@color/ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="校内规定、课程资料、我的成绩课表，都可以问我"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="我可以帮你"
                        android:textColor="@color/ink_subtle"
                        android:textSize="12sp" />

                    <GridLayout
                        android:id="@+id/gridCapabilities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:columnCount="3"
                        android:rowCount="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="试试这样问"
                        android:textColor="@color/ink_subtle"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/boxSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- 对话消息 -->
                <LinearLayout
                    android:id="@+id/boxMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- 输入区（透明底，浮在页面上） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:maxLines="4"
                    android:background="@drawable/bg_ai_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:hint="可以问我：宿舍几点熄灯？"
                    android:textColorHint="@color/ink_subtle"
                    android:textSize="14sp"
                    android:inputType="textMultiLine|textCapSentences" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="72dp"
                    android:text="发送"
                    android:textSize="14sp"
                    android:textColor="@color/on_primary"
                    android:background="@drawable/bg_ai_send"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
