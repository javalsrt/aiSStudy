<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <!-- ========== 顶部区域 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/surface_1">

        <!-- 第一行：周数 + 年月日 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 周数按钮（可点击选择） -->
            <TextView
                android:id="@+id/tv_week_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="第1周"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingEnd="12dp"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:drawablePadding="4dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- 天气 + 班级在线（仿 QQ 顶栏） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_weather_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/ink_subtle"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- 好友在线（有同班同学在线才显示） -->
                <TextView
                    android:id="@+id/tv_online_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text=""
                    android:textColor="@color/success"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 今天按钮（44dp 满足触摸目标） -->
            <TextView
                android:id="@+id/btn_today"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="52dp"
                android:gravity="center"
                android:text="今天"
                android:textColor="@color/on_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_today_btn"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 第二行：周选择器（1-18） -->
        <HorizontalScrollView
            android:id="@+id/scroll_weeks"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:scrollbars="none"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/container_weeks"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hairline" />

    <!-- ========== 课表网格 8×8（含骨架屏加载层） ========== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:id="@+id/scroll_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingBottom="104dp"
            android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 表头行 -->
            <LinearLayout
                android:id="@+id/row_header"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:background="@color/surface_3">
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <!-- 课表内容区（无嵌套 ScrollView，全部撑满底部） -->
            <LinearLayout
                android:id="@+id/grid_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 骨架屏加载层：圆形 + 双行条块，脉冲呼吸动画 -->
    <LinearLayout
        android:id="@+id/skeleton_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:background="@color/canvas"
        android:visibility="gone">

        <LinearLayout style="@style/SkeletonRow">
            <View style="@style/SkeletonCircle" />
            <LinearLayout style="@style/SkeletonLines">
                <View style="@style/SkeletonBar" android:layout_width="120dp" />
                <View style="@style/SkeletonBar" android:layout_width="160dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/SkeletonRow">
            <View style="@style/SkeletonCircle" />
            <LinearLayout style="@style/SkeletonLines">
                <View style="@style/SkeletonBar" android:layout_width="150dp" />
                <View style="@style/SkeletonBar" android:layout_width="110dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/SkeletonRow">
            <View style="@style/SkeletonCircle" />
            <LinearLayout style="@style/SkeletonLines">
                <View style="@style/SkeletonBar" android:layout_width="100dp" />
                <View style="@style/SkeletonBar" android:layout_width="170dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/SkeletonRow">
            <View style="@style/SkeletonCircle" />
            <LinearLayout style="@style/SkeletonLines">
                <View style="@style/SkeletonBar" android:layout_width="140dp" />
                <View style="@style/SkeletonBar" android:layout_width="120dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
