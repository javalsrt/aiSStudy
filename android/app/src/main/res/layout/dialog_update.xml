<?xml version="1.0" encoding="utf-8"?>
<!-- App 更新弹窗：新版本说明 + 下载进度 + 操作按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_update_card"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_update_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发现新版本"
            android:textSize="18sp"
            android:textColor="@color/ink"
            android:fontFamily="@font/harmonyos_sans_sc_medium" />

        <TextView
            android:id="@+id/tv_update_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="当前版本 v1.3"
            android:textSize="12sp"
            android:textColor="@color/ink_subtle" />

        <TextView
            android:id="@+id/tv_update_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="更新内容"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ink_muted"
            android:maxLines="8"
            android:ellipsize="end" />

        <!-- 下载进度：下载时显示 -->
        <LinearLayout
            android:id="@+id/ll_update_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pb_update"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/primary"
                android:progressBackgroundTint="@color/hairline" />

            <TextView
                android:id="@+id/tv_update_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0%"
                android:textSize="12sp"
                android:textColor="@color/ink_subtle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_update_later"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="稍后"
                android:textSize="15sp"
                android:textColor="@color/ink"
                android:fontFamily="@font/harmonyos_sans_sc_medium"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_update_now"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="立即更新"
                android:textSize="15sp"
                android:textColor="@color/on_primary"
                android:fontFamily="@font/harmonyos_sans_sc_medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
