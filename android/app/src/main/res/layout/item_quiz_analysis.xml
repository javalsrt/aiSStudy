<?xml version="1.0" encoding="utf-8"?>
<!--
  解析题卡片。
  题干与作答区包在 ScrollView 里：软键盘弹起后可用高度变小，内容仍可滚动到输入框，
  输入框改用最小高度而非 weight 撑满，避免被挤压成 0 高度导致「看不见但能输入」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas"
    android:paddingTop="16dp"
    android:paddingHorizontal="12dp"
    android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_quiz_card"
        android:padding="20dp">

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">
                    <TextView android:id="@+id/tv_quiz_tag" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="解析题"
                        android:textSize="12sp" android:textColor="@color/primary"
                        android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                        android:background="@drawable/bg_tag" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/tv_quiz_num" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="1/15"
                        android:textSize="13sp" android:textColor="@color/ink_subtle"
                        android:fontFamily="@font/harmonyos_sans_sc_medium" />
                </LinearLayout>

                <TextView android:id="@+id/tv_quiz_question" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="题目内容"
                    android:textSize="19sp" android:textColor="@color/ink"
                    android:lineSpacingExtra="6dp" android:layout_marginBottom="20dp" />

                <com.znxsgl.student.widget.FunctionPlotView
                    android:id="@+id/graph_view"
                    android:layout_width="match_parent" android:layout_height="190dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"
                    android:background="@drawable/bg_graph_panel"
                    android:padding="10dp" />

                <EditText android:id="@+id/et_answer" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp"
                    android:gravity="top|start" android:padding="16dp"
                    android:background="@drawable/bg_input"
                    android:hint="请输入你的答案..."
                    android:inputType="textMultiLine"
                    android:textSize="15sp" android:textColor="@color/ink"
                    android:textColorHint="@color/ink_tertiary" />
            </LinearLayout>
        </ScrollView>

        <TextView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="完成后点击下方「长按提交」"
            android:textSize="11sp" android:textColor="@color/ink_tertiary"
            android:gravity="center" android:padding="12dp" />
    </LinearLayout>
</LinearLayout>
