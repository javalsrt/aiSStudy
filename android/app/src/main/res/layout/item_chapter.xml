<?xml version="1.0" encoding="utf-8"?>
<!-- 树形视图：章 = 可展开的分支节点（文件夹），紧凑 32dp 行高 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_chapter_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_tree_row"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_chapter_chevron"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_tree_chevron_right"
            android:tint="@color/ink_subtle"
            android:contentDescription="展开章节" />

        <ImageView
            android:id="@+id/iv_chapter_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_tree_folder"
            android:tint="@color/ink_muted"
            android:contentDescription="章节" />

        <TextView
            android:id="@+id/tv_chapter_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="章节名称"
            android:textSize="13sp"
            android:textColor="@color/ink"
            android:fontFamily="@font/harmonyos_sans_sc_medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_chapter_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0/0"
            android:textSize="10sp"
            android:textColor="@color/ink_subtle"
            android:fontFamily="@font/harmonyos_sans_sc_medium" />
    </LinearLayout>

    <!-- 子级课时列表，缩进形成层级 -->
    <LinearLayout
        android:id="@+id/ll_lessons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
