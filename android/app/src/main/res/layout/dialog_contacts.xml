<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_contacts_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通讯录"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:fontFamily="@font/harmonyos_sans_sc_medium" />

            <TextView
                android:id="@+id/tv_head_teacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ink_subtle"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/ink_subtle"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 可滚动内容区 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 任课教师 -->
            <TextView
                android:id="@+id/tv_teacher_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任课教师"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:fontFamily="@font/harmonyos_sans_sc_medium" />

            <LinearLayout
                android:id="@+id/ll_teachers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_no_teachers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="暂无任课教师"
                android:textColor="@color/ink_subtle"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 同班同学 -->
            <TextView
                android:id="@+id/tv_classmate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="同班同学"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:fontFamily="@font/harmonyos_sans_sc_medium" />

            <LinearLayout
                android:id="@+id/ll_classmates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_no_classmates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="暂无同班同学"
                android:textColor="@color/ink_subtle"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
