<?xml version="1.0" encoding="utf-8"?>
<!-- 模仿 Pricing Card：白底大圆角卡片 + 灰色标题/副标题 + 大号细体字 + 黑色胶囊按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_quiz_panel"
    android:elevation="2dp"
    android:clipToOutline="true"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#4B5563"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#6B7280"
        android:textSize="10sp" />

    <!-- 大号细体字（对应 text-5xl font-light）+ 小字后缀（对应 /mo） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="#111827"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="· 练习"
            android:textColor="#6B7280"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 底部按钮行：章节（浅灰） + 开始（黑色胶囊） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_chapter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:background="@drawable/bg_quiz_panel_btn_light"
            android:paddingVertical="9dp"
            android:text="章节"
            android:textColor="#1D1D1F"
            android:textSize="12sp" />

        <!-- 黑色胶囊按钮（对应 rounded-full bg-black） -->
        <TextView
            android:id="@+id/btn_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_quiz_panel_btn"
            android:paddingVertical="9dp"
            android:text="开始"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
