<?xml version="1.0" encoding="utf-8"?>
<!-- 学习页课程卡片：饱和纯色卡（白粗标题）+ 底部深色信息条 + 右侧错层浅色纸片
     颜色均由 FocusFragment.stylePanel 按卡片主色动态注入 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背后错层纸片：右侧露出一条浅色边（混白 55% 的主色） -->
    <View
        android:id="@+id/sheet_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp" />

    <!-- 主卡片：左对齐，右侧留出纸片露边 -->
    <FrameLayout
        android:id="@+id/card_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:elevation="2dp">

        <!-- 标题：白色粗体，最多两行 -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingTop="16dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <!-- 兼容旧逻辑保留，不再展示 -->
        <TextView
            android:id="@+id/tv_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="30sp" />

        <!-- 底部深色信息条：「教师 | 章节学习 | 随时练」+ 右侧白色胶囊按钮 -->
        <LinearLayout
            android:id="@+id/ll_meta_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/tv_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/bg_panel_btn_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="开始"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 兼容旧逻辑保留：章节入口已改为点击卡片本体 -->
        <TextView
            android:id="@+id/btn_chapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>
