<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <!-- 顶部栏（已隐藏：不显示标题与专注统计） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView android:id="@+id/btn_back"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹" android:textSize="28sp" android:textColor="@color/primary"
            android:padding="8dp" android:clickable="true" android:focusable="true" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center">
            <TextView android:id="@+id/tv_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="专注刷题" android:textSize="17sp" android:textColor="@color/ink"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:paddingHorizontal="12dp" android:paddingVertical="4dp"
            android:background="@drawable/bg_tag"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏱ " android:textSize="16sp" />
            <TextView android:id="@+id/tv_timer_corner"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00" android:textSize="16sp" android:textColor="@color/primary"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- 切换容器 -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

        <!-- 课程网格（动态2列） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_quiz_panels"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="24dp"
            android:clipToPadding="false" />

        <!-- 答题区 -->
        <LinearLayout android:id="@+id/ll_quiz_area"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:visibility="gone"
            android:paddingBottom="72dp"
            android:background="@color/canvas">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewpager_quiz"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center"
                android:padding="16dp" android:background="@color/canvas">
                <TextView android:id="@+id/btn_quiz_done"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:text="长按提交" android:textSize="14sp" android:textColor="@color/on_primary"
                    android:gravity="center" android:background="@drawable/bg_btn_primary"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true" android:focusable="true" android:longClickable="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
