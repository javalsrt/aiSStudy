<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 整页背景：护眼白黄点场（静态，无动画） -->
    <com.znxsgl.student.widget.DotFieldView
        android:id="@+id/dot_field_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部栏（已隐藏：不显示标题与专注统计） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView android:id="@+id/btn_back"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="‹" android:textSize="28sp" android:textColor="@color/primary"
                android:padding="8dp" android:clickable="true" android:focusable="true" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center">
                <TextView android:id="@+id/tv_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="专注刷题" android:textSize="17sp" android:textColor="@color/ink"
                    android:fontFamily="@font/harmonyos_sans_sc_medium" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center"
                android:paddingHorizontal="12dp" android:paddingVertical="4dp"
                android:background="@drawable/bg_tag"
                android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⏱ " android:textSize="16sp" />
                <TextView android:id="@+id/tv_timer_corner"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="00:00" android:textSize="16sp" android:textColor="@color/primary"
                    android:fontFamily="@font/harmonyos_sans_sc_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- 切换容器 -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

            <!-- 课程纸卡舞台：卡片由代码动态加入，默认为一摞，可自由拖动 -->
            <FrameLayout
                android:id="@+id/paper_board"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="104dp" />

            <!-- 右上角：恢复默认排列（点击后卡片飞回左上角依次铺开） -->
            <TextView
                android:id="@+id/btn_paper_reset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_paper_reset"
                android:gravity="center"
                android:text="+"
                android:textColor="#8A6D33"
                android:textSize="24sp"
                android:fontFamily="@font/harmonyos_sans_sc_medium"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="恢复默认排列" />

            <!-- 答题区（全屏：导航隐藏，提交按钮悬浮在导航栏位置，外观同导航胶囊） -->
            <LinearLayout android:id="@+id/ll_quiz_area"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:visibility="gone"
                android:background="@color/surface_1">

                <!-- 顶部：关闭 + 分段进度 + 题号 -->
                <LinearLayout android:id="@+id/quiz_header"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingTop="26dp" android:paddingBottom="6dp"
                    android:paddingStart="10dp" android:paddingEnd="16dp">
                    <TextView android:id="@+id/btn_quiz_close"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="×" android:textSize="26sp" android:textColor="@color/ink_muted"
                        android:padding="8dp" android:clickable="true" android:focusable="true" />
                    <com.znxsgl.student.widget.SegmentedProgressView
                        android:id="@+id/quiz_segments"
                        android:layout_width="0dp" android:layout_height="10dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp" android:layout_marginEnd="12dp" />
                    <TextView android:id="@+id/tv_quiz_counter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="1/15" android:textSize="13sp" android:textColor="@color/ink_muted"
                        android:fontFamily="@font/harmonyos_sans_sc_medium" />
                </LinearLayout>

                <!-- 旧细线进度条保留（代码仍引用），新界面用分段进度条 -->
                <ProgressBar android:id="@+id/quiz_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:max="100" android:progress="0" android:visibility="gone"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/hairline" />
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewpager_quiz"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />
                <LinearLayout android:id="@+id/quiz_submit_bar"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
                    <com.znxsgl.student.widget.HoldSubmitButton android:id="@+id/btn_quiz_done"
                        android:layout_width="match_parent" android:layout_height="64dp"
                        android:text="长按提交" android:textSize="16sp" android:textColor="@color/primary"
                        android:letterSpacing="0.05"
                        android:gravity="center" android:fontFamily="@font/harmonyos_sans_sc_medium"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
