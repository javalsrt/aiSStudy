<?xml version="1.0" encoding="utf-8"?>
<!--
  根布局改为 FrameLayout：内容全屏铺开，底部导航作为悬浮层叠在内容之上。
  导航 = 白色药丸形容器（悬浮、圆角、微透明 + 细描边 + 柔和投影）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!--
      内容区：全屏铺开，页面自身背景延伸到悬浮药丸下方（不再露出灰色垫层）；
      各 Fragment 在自己的滚动内容里补底部内边距，避免内容被药丸遮挡。
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 悬浮药丸导航 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="8dp"
        android:outlineProvider="background"
        app:itemActiveIndicatorStyle="@style/NavIndicatorTransparent"
        app:itemIconSize="24dp"
        app:itemTextColor="@color/selector_nav_text"
        app:itemIconTint="@color/selector_nav_icon"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</FrameLayout>
