<?xml version="1.0" encoding="utf-8"?>
<!--
  根布局改为 FrameLayout：内容全屏铺开，底部导航作为悬浮层叠在内容之上。
  导航 = 白色药丸形容器（悬浮、圆角、微透明 + 细描边 + 柔和投影）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!--
      内容区：全屏铺开，页面自身背景延伸到悬浮药丸下方（不再露出灰色垫层）；
      各 Fragment 在自己的滚动内容里补底部内边距，避免内容被药丸遮挡。
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 悬浮药丸导航的毛玻璃底：截取导航正后方的页面内容做缩放模糊，
         叠加白色薄雾、玻璃高光与描边；自身不接收触摸事件 -->
    <com.znxsgl.student.widget.GlassNavBackgroundView
        android:id="@+id/nav_glass"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp"
        android:importantForAccessibility="no" />

    <!-- 悬浮药丸导航（背景透明，视觉完全交给上方的毛玻璃底）
         注意：不要给它加 paddingHorizontal。M3 底部导航是按等分槽位排布（每个 tab 占 1/N），
         左右 padding 会把两端挤出大片空白（4 个 tab 时尤其明显）；
         padding = 0 时端到端间隙恰为相邻间隙的一半，分布最平均（同 iOS Tab Bar）。 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:elevation="8dp"
        android:translationZ="10dp"
        app:itemActiveIndicatorStyle="@style/NavIndicatorTransparent"
        app:itemIconSize="24dp"
        app:itemTextColor="@color/selector_nav_text"
        app:itemIconTint="@color/selector_nav_icon"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!--
      中间 AI 星星的点击爆发动效层（声波涟漪 + 星芒 + 粒子）。
      铺满整屏但 clickable/focusable 均为 false，触摸事件会穿透到下层导航，
      只在 AI 图标位置绘制，不影响其他页签的点击与无障碍。
    -->
    <com.znxsgl.student.widget.AiTabBurstView
        android:id="@+id/ai_tab_burst"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="12dp"
        android:translationZ="8dp"
        android:importantForAccessibility="no"
        android:outlineProvider="none" />

</FrameLayout>
