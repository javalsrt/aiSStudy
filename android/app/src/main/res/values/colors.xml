<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Canvas & Surface (iOS Flat Light Gray System) -->
    <color name="canvas">#F2F2F7</color>
    <color name="surface_1">#FFFFFF</color>
    <color name="surface_2">#F9F9FB</color>
    <color name="surface_3">#F0F0F4</color>

    <!-- Brand Accent：iOS 系统蓝（扁平，无渐变） -->
    <color name="primary">#0A84FF</color>
    <color name="primary_hover">#0071E3</color>
    <color name="primary_disabled">#A8CBF0</color>
    <color name="primary_soft">#E5F1FF</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- Text -->
    <color name="ink">#1D1D1F</color>
    <color name="ink_muted">#6E6E73</color>
    <color name="ink_subtle">#8E8E93</color>
    <color name="ink_tertiary">#C7C7CC</color>

    <!-- Hairline Borders -->
    <color name="hairline">#E5E5EA</color>
    <color name="hairline_strong">#D1D1D6</color>

    <!-- Semantic（iOS 系统色） -->
    <color name="success">#34C759</color>
    <color name="warning">#FF9500</color>
    <color name="danger">#FF3B30</color>

    <!-- Exam（统一到主色系） -->
    <color name="exam_action">@color/primary</color>
    <color name="exam_card_bg">@color/primary_soft</color>
    <color name="exam_card_border">#B3D7FF</color>
    <color name="exam_icon_bg">@color/primary</color>

    <!-- Others -->
    <color name="inverse_canvas">#1D1D1F</color>
    <color name="inverse_ink">#FFFFFF</color>
    <color name="white">#FFFFFF</color>

    <!-- Legacy aliases（历史引用平滑迁移，勿新增使用） -->
    <color name="background">@color/canvas</color>
    <color name="divider">@color/hairline</color>
    <color name="accent_blue">@color/primary</color>
    <color name="accent_green">@color/success</color>
    <color name="text_primary">@color/ink</color>
    <color name="text_secondary">@color/ink_subtle</color>
    <color name="text_tertiary">@color/ink_tertiary</color>
    <color name="card_background">@color/surface_1</color>
    <color name="error_red">@color/danger</color>
</resources>
