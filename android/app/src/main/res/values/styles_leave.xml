<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LeaveLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <style name="LeaveInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_ai_input</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1F2937</item>
        <item name="android:textColorHint">#9CA3AF</item>
    </style>
</resources>
