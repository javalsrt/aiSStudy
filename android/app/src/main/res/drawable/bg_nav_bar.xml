<?xml version="1.0" encoding="utf-8"?>
<!-- 学习 uiverse yellow-rattlesnake-26 的玻璃倒角效果（配色保持本 App 方案）：
     底层 = 白色胶囊 + 1dp 发丝线；上层 = 内缩 2dp 的半透明白描边，模拟
     原版 ::after 的 inset 白色高光（玻璃倒角）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层：白色微透明胶囊 + 发丝线 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FAFFFFFF" />
            <corners android:radius="36dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hairline" />
        </shape>
    </item>
    <!-- 内层：玻璃倒角高光（内缩 2dp 的半透明白描边） -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <stroke
                android:width="2dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
